{
    "compilerOptions": {
      "outDir": "dist",
      "rootDir": "src",
      "moduleResolution": "node",
      "module": "ESNext",
      "target": "ES2020",
      "lib": ["ES2020"],
      "strict": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "declaration": true,
      "declarationMap": true,
      "types": ["node"],
      "typeRoots": [
        "./node_modules/@types",
        "./node_modules"
      ],
      "skipDefaultLibCheck": true
    },
    "include": ["src", "scripts"],
    "exclude": ["node_modules", "dist"]
  }